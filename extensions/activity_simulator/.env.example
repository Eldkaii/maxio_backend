# Copy these keys into the project .env. Disabled unless explicitly enabled.
SIMULATOR_ENABLED=false
SIMULATOR_API_URL=http://127.0.0.1:8000
SIMULATOR_MAX_PLAYERS=40
SIMULATOR_SIGNUP_MIN_HOURS=2
SIMULATOR_SIGNUP_MAX_HOURS=8
SIMULATOR_STARTUP_DELAY_SECONDS=300
SIMULATOR_TICK_SECONDS=30
SIMULATOR_SPEED_MULTIPLIER=1
# Optional absolute file path; defaults to .local/activity-simulator.json
# SIMULATOR_STATE_PATH=C:/Proyectos/Max_io/.local/activity-simulator.json
